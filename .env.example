# Trezarr docker-compose environment — copy to `.env` and fill in.
#   cp .env.example .env   &&   edit .env   (.env is gitignored)
# docker compose reads this automatically for ${VAR} interpolation in
# docker-compose.yml. Only TREZARR_LLM_API_KEY is required; the rest override
# the defaults baked into docker-compose.yml.

# ── Required ─────────────────────────────────────────────────────────────────
# Your LLM endpoint API key (kept out of the committed compose file).
TREZARR_LLM_API_KEY=

# ── Optional overrides (defaults shown match the current deployment) ─────────
# TREZARR_LLM_BASE_URL=https://api.tlemons.com/v1
# TREZARR_LLM_MODEL=ds/deepseek-v4-pro

# UID:GID that owns your media files (so .vi.srt sidecars get correct ownership).
# PUID=501
# PGID=20

# Host directories bind-mounted into the container.
# The media CONTAINER path stays /data/media (set in docker-compose.yml) — only
# the HOST side is configured here; it must contain the media Sonarr/Radarr see.
# TREZARR_CONFIG_DIR=/Users/dustin/trezarr-config
# TREZARR_MEDIA_DIR=/Users/dustin/trezarr-uat-media

# Optional: inject *arr API keys via env instead of config.yaml.
# TREZARR_SONARR_API_KEY=
# TREZARR_RADARR_API_KEY=
# TREZARR_BAZARR_API_KEY=
